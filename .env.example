# Copy to .env and fill in real values. .env is git-ignored.
# Docker Compose reads this file automatically; local dev can `export $(cat .env)`
# or use a tool like direnv / python-dotenv.

# --- Database (Postgres holding the raw Olist tables) ---
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=olist
POSTGRES_PORT=5433
CONFIG__DATABASE__URL=postgresql://mlops:mlops@db:5433/olist

# --- MLflow tracking server ---
MLFLOW_PORT=5000
CONFIG__MLFLOW__TRACKING_URI=http://mlflow:5000
# MLflow uses SQLite metadata and a shared local artifact volume in Docker.
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=file:///mlartifacts

# --- API service ---
CONFIG__API__PORT=8000
API_PORT=8000
