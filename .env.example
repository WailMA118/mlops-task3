# Copy to .env and fill in real values. .env is git-ignored.
# Docker Compose reads this file automatically; local dev can `export $(cat .env)`
# or use a tool like direnv / python-dotenv.

# --- Database (Postgres holding the raw Olist tables) ---
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=olist
POSTGRES_PORT=5433
CONFIG__DATABASE__URL=postgresql://mlops:mlops@db:5433/olist

# --- MLflow tracking server ---
MLFLOW_PORT=5000
CONFIG__MLFLOW__TRACKING_URI=http://mlflow:5000
# Backend store for MLflow metadata (Postgres) and artifact store (e.g. MinIO/S3)
MLFLOW_BACKEND_STORE_URI=postgresql://mlops:mlops@db:5433/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts/

# --- Object storage for DVC remote / MLflow artifacts (MinIO, S3-compatible) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# --- API service ---
CONFIG__API__PORT=8000
API_PORT=8000
